Class B4XClockNumber Extends B4XClockDrawableBase Final

Property Value As Int = 12
Property RadiusRatio As Float = 0.78
Property FontSize As Int = 16

Sub Class_Globals
    Private xui As XUI
End Sub

Constructor(NumberValue As Int)
    Super.Initialize
    mValue = NumberValue
End Constructor

Override Sub Draw(Canvas As B4XCanvas, CenterX As Float, CenterY As Float, Radius As Float)
    If mVisible = False Then Return
    Dim angle As Float = mValue * 30
    Dim tx As Float = B4XClockMath.PointX(CenterX, Radius * mRadiusRatio, angle)
    Dim ty As Float = B4XClockMath.PointY(CenterY, Radius * mRadiusRatio, angle) + (mFontSize / 2.8)
    Canvas.DrawText(mValue, tx, ty, xui.CreateDefaultBoldFont(mFontSize), mColor, "CENTER")
End Sub

End Class
