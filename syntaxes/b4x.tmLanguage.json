{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "B4X",
  "scopeName": "source.b4x",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#embeddedCssBlock"
    },
    {
      "include": "#embeddedJavaScriptBlock"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#oopModifiers"
    },
    {
      "include": "#b4xKeywords"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.b4xpp",
          "match": "'.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "meta.embedded.inline.html.b4x",
          "begin": "\\$\\\"(?=\\s*(?:<!DOCTYPE\\s+html\\b|</?[A-Za-z][\\w:-]*(?:\\s|>|/)))",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.b4x"
            }
          },
          "end": "\\\"\\$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.b4x"
            }
          },
          "patterns": [
            {
              "name": "meta.interpolation.b4x.b4x",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "source.b4x"
                }
              ]
            },
            {
              "name": "constant.character.escape.b4x",
              "match": "\\\"\\\""
            },
            {
              "include": "text.html.basic"
            }
          ]
        },
        {
          "name": "meta.embedded.inline.html.b4x",
          "begin": "\\$\\\"\\s*$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.b4x"
            }
          },
          "end": "\\\"\\$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.b4x"
            }
          },
          "patterns": [
            {
              "name": "meta.interpolation.b4x.b4x",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "source.b4x"
                }
              ]
            },
            {
              "name": "constant.character.escape.b4x",
              "match": "\\\"\\\""
            },
            {
              "include": "text.html.basic"
            }
          ]
        },
        {
          "name": "meta.embedded.inline.javascript.b4x",
          "begin": "\\$\\\"(?=\\s*\\[BAN(?:RAW|CLEAN)\\]\\s*[\\{\\[])",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.b4x"
            }
          },
          "end": "\\\"\\$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.b4x"
            }
          },
          "patterns": [
            {
              "name": "meta.interpolation.b4x.b4x",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "source.b4x"
                }
              ]
            },
            {
              "name": "constant.language.banano.smartstring.b4x",
              "match": "(?i)\\[BAN(?:RAW|CLEAN)\\]"
            },
            {
              "name": "constant.character.escape.b4x",
              "match": "\\\"\\\""
            },
            {
              "include": "source.js"
            }
          ]
        },
        {
          "name": "string.quoted.smart.b4x.b4x",
          "begin": "\\$\\\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.b4x"
            }
          },
          "end": "\\\"\\$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.b4x"
            }
          },
          "patterns": [
            {
              "name": "meta.interpolation.b4x.b4x",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "source.b4x"
                }
              ]
            },
            {
              "name": "constant.character.escape.b4x",
              "match": "\\\"\\\""
            }
          ]
        },
        {
          "name": "string.quoted.double.b4x",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.b4x",
              "match": "\\\"\\\""
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.b4xpp",
          "match": "(?i)^\\s*#(?:Project|Package|ProjectDir|MobileMain|MainModule|ProjectDependsOn|ProjectB4ADependsOn|ProjectB4JDependsOn|ProjectB4iDependsOn|BANano[A-Za-z0-9_]*|B4XLib|B4XLibDir|B4XLibVersion|B4XLibAuthor|B4XLibSupportedPlatforms|B4XLibDependsOn|B4XLibB4ADependsOn|B4XLibB4JDependsOn|B4XLibB4iDependsOn|B4XPPLib|B4XPPLibDir|B4XPPLibVersion|B4XPPLibAuthor|B4XPPLibSupportedPlatforms|B4XPPLibDependsOn|B4XPPLibB4ADependsOn|B4XPPLibB4JDependsOn|B4XPPLibB4iDependsOn|LibraryFilesDir|Version|Author|DependsOn|B4ADependsOn|B4JDependsOn|B4iDependsOn|SupportedPlatforms|ShortName|Include|Interface|End\\s+Interface|Class|End\\s+Class|MainModule|Extends|Implements|Abstract|Final|Constructor|End\\s+Constructor|Property|Region|End\\s+Region|If|Else|End\\s+If|IgnoreWarnings|DesignerProperty|Event|RaisesSynchronousEvents|AdditionalJar|AdditionalLib|BridgeLogger|CustomBuildAction|DebuggerForceStandardAssets|DebuggerForceFullDeployment|ExcludedLib|LibraryAuthor|LibraryName|LibraryVersion|Macro|MacroAfter|MacroEnd|MergeLibraries|ModuleVisibility|PackagerProperty|SupportedOrientations|VersionCode|VersionName|AppType|Build\\d+|File\\d+|FileGroup\\d+|Library\\d+|Module\\d+|NumberOfFiles|NumberOfLibraries|NumberOfModules|ManifestCode|Group|ModulesStructureVersion|Type|Version|EndOfDesignText|Activity|Service|Receiver)\\b"
        }
      ]
    },
    "oopModifiers": {
      "patterns": [
        {
          "name": "storage.modifier.oop.b4xpp",
          "match": "(?i)\\b(?:Override|Virtual|Protected|Abstract|Final|Async|Await|Poly|Closure|Super|This|ReadOnly|WriteOnly)\\b"
        }
      ]
    },
    "b4xKeywords": {
      "patterns": [
        {
          "name": "keyword.control.b4xpp",
          "match": "(?i)\\b(?:Class|End\\s+Class|Interface|End\\s+Interface|StaticCode|End\\s+StaticCode|Constructor|End\\s+Constructor|Property|Extends|Implements|Sub|End\\s+Sub|If|Then|Else|End\\s+If|For|Each|Next|Do|Loop|While|Wend|Select|Case|End\\s+Select|Try|Catch|End\\s+Try|Return|Exit|Continue|Wait\\s+For|CallSub|CallSubDelayed|Sleep|As|Is|And|Or|Not|True|False|Null|Dim|Private|Public|Type|Map|List)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.b4xpp",
          "match": "\\b(?:0x[0-9A-Fa-f]+|\\d+(?:\\.\\d+)?)\\b"
        }
      ]
    },
    "embeddedCssBlock": {
      "patterns": [
        {
          "name": "meta.embedded.block.css.b4x",
          "begin": "(?i)^\\s*(#If)\\s+(CSS)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.b4xpp"
            },
            "2": {
              "name": "entity.name.tag.preprocessor.css.b4xpp"
            }
          },
          "end": "(?i)^\\s*(#End)\\s+(If)\\s*$",
          "endCaptures": {
            "1": {
              "name": "keyword.control.directive.b4xpp"
            },
            "2": {
              "name": "keyword.control.directive.b4xpp"
            }
          },
          "patterns": [
            {
              "include": "source.css"
            }
          ]
        }
      ]
    },
    "embeddedJavaScriptBlock": {
      "patterns": [
        {
          "name": "meta.embedded.block.javascript.b4x",
          "begin": "(?i)^\\s*(#If)\\s+(JAVASCRIPT|JS|SMARTJAVASCRIPT|JAVASCRIPTSMART)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.b4xpp"
            },
            "2": {
              "name": "entity.name.tag.preprocessor.js.b4xpp"
            }
          },
          "end": "(?i)^\\s*(#End)\\s+(If)\\s*$",
          "endCaptures": {
            "1": {
              "name": "keyword.control.directive.b4xpp"
            },
            "2": {
              "name": "keyword.control.directive.b4xpp"
            }
          },
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        }
      ]
    }
  }
}
